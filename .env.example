# Copy to .env and fill in local values. Never commit .env.
WEB_PORT=7001
IPA_DATA_DIR=/srv/data/app-store-workbench
IPA_RETENTION_DAYS=7
IPA_DOWNLOAD_TIMEOUT_MINUTES=60
SEARCH_CONCURRENCY=3
PRODUCT_PAGE_CACHE_TTL_SECONDS=600
PRODUCT_PAGE_CACHE_MAX_ENTRIES=200

# Required to decrypt the ipatool file keychain in a headless container.
IPATOOL_KEYCHAIN_PASSPHRASE=change-me

# Optional outbound proxy for ipatool (empty = direct).
IPATOOL_PROXY=
