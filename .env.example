# Copy to .env and fill in local values. Never commit .env.
WEB_PORT=7001
IPA_DATA_DIR=/srv/data/app-store-workbench
IPA_RETENTION_DAYS=7
IPA_DOWNLOAD_TIMEOUT_MINUTES=60
SEARCH_CONCURRENCY=3
PRODUCT_PAGE_CACHE_TTL_SECONDS=600
PRODUCT_PAGE_CACHE_MAX_ENTRIES=200

# Required to decrypt the ipatool file keychain in a headless container.
IPATOOL_KEYCHAIN_PASSPHRASE=change-me

# Optional outbound proxy for ipatool (empty = direct). When the app container
# is attached to an external proxy network, use that network's service name,
# for example: http://network-proxy:7890
IPATOOL_PROXY=

# Local PostgreSQL (peer auth, no password). Port 5433 on this host.
# Used by the competitor daily snapshot feature.
# Unix socket form (this host listens on the socket only, no TCP on 5433).
DATABASE_URL=postgres://aurora@/appstore_workbench?host=/var/run/postgresql&port=5433

# Competitor daily snapshot feature (values live in .env, never committed).
FIRST_DELIVERY_API_BASE_URL=
FIRST_DELIVERY_API_KEY=
