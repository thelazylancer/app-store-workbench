+// refreshCmd refreshes the stored password token with a 2FA code. The App
+// Store login flow persists the refreshed account in the keychain, so a single
+// successful refresh covers every later download in the same session.
+//
+//nolint:wrapcheck
+func refreshCmd() *cobra.Command {
+	var authCode string
+
+	cmd := &cobra.Command{
+		Use:   "refresh",
+		Short: "Refresh the stored App Store session using a 2FA code",
+		RunE: func(cmd *cobra.Command, args []string) error {
+			infoResult, err := dependencies.AppStore.AccountInfo()
+			if err != nil {
+				return err
+			}
+
+			acc := infoResult.Account
+			if acc.Password == "" {
+				return errors.New("the stored account has no password; run `ipatool auth login` first")
+			}
+
+			loginResult, err := dependencies.AppStore.Login(appstore.LoginInput{
+				Email:    acc.Email,
+				Password: acc.Password,
+				AuthCode: authCode,
+			})
+			if err != nil {
+				return err
+			}
+
+			dependencies.Logger.Log().
+				Str("name", loginResult.Account.Name).
+				Str("email", loginResult.Account.Email).
+				Bool("success", true).
+				Send()
+
+			return nil
+		},
+	}
+
+	cmd.Flags().StringVar(&authCode, "auth-code", "", "6-digit 2FA code for the Apple ID")
+
+	return cmd
+}
+
